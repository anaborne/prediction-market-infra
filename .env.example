# Copy to .env and fill in. Every variable is documented in docs/configuration.md.

# Kalshi API credentials (demo environment)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_demo_private_key.pem

# Polymarket US credentials (CFTC-regulated venue; the one a US person trades)
#
# Obtained at polymarket.us/developer after KYC in the iOS app. The secret is
# shown once at creation. If it is lost, revoke the key and make a new one.
#
# Public market data on gateway.polymarket.us needs NO credentials; these are
# only for placing orders and for the two WebSocket streams on api.polymarket.us.
#
# Auth is Ed25519 over `timestamp + METHOD + path`, base64-encoded, with a
# 30-second timestamp window. See docs/GUIDE.md section 2.13.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# Polymarket US base URLs. The split is load-bearing: the gateway host is public
# and the api host is authenticated. Probing only the latter is what produced a
# wrong "no public data exists" conclusion once already.
POLYMARKET_US_GATEWAY_URL=https://gateway.polymarket.us
POLYMARKET_US_API_URL=https://api.polymarket.us
POLYMARKET_US_WS_URL=wss://api.polymarket.us/v1/ws

# Base URLs (REST)
KALSHI_DEMO_BASE_URL=https://external-api.demo.kalshi.co
KALSHI_PROD_BASE_URL=https://external-api.kalshi.com

# Base URLs (WebSocket), a distinct host from REST, not a derivation of it
KALSHI_DEMO_WS_URL=wss://external-api-ws.demo.kalshi.co
KALSHI_PROD_WS_URL=wss://external-api-ws.kalshi.com

# Environment selection: "demo" or "prod"
KALSHI_ENVIRONMENT=demo

# Telemetry
KALSHI_TELEMETRY_DB_PATH=./data/telemetry.sqlite

# Poller/executor IPC, see the poller/executor IPC design
KALSHI_IPC_SOCKET_PATH=./data/executor.sock

# Executor order behavior. KALSHI_FIXED_ORDER_CONTRACT_COUNT is the size used for every shadow
# fire and the floor under every real fire's Kelly-sized count, see "Position sizing" below.
KALSHI_FIXED_ORDER_CONTRACT_COUNT=1
KALSHI_ORDER_TIME_IN_FORCE=fill_or_kill
KALSHI_ORDER_SELF_TRADE_PREVENTION_TYPE=taker_at_cross

# Demo shards real orders may route to (comma-separated exchange_index values). The executor
# refuses to start when this is empty or names a shard the account holds no balance on.
# run scripts/check_shards.py to see the funded set. The crypto series live on shard 2.
KALSHI_ALLOWED_EXCHANGE_INDEXES=2

# Kill switch: this file existing halts new real dispatch. Operate via scripts/killswitch.py.
KALSHI_KILLSWITCH_PATH=./data/killswitch

# Rotating per-process log files (poller.log, executor.log, dashboard.log) land here.
KALSHI_LOG_DIR=./data/logs

# Risk gate caps (execution/risk.py), real orders only, checked immediately before dispatch.
# Values below are the codebase's own conservative defaults; leaving all eleven unset (counting
# the cooldown) is identical to setting them explicitly to these numbers. Widen them for a low-stakes paper run
# where you want to see fills happen; before ever pointing this file at a funded real-money
# account, put them back to something this conservative (or tighter), see docs/configuration.md's
# "Risk gate" section for what each one bounds.
KALSHI_RISK_MAX_ATTEMPTS_PER_HOUR=10
KALSHI_RISK_MAX_ATTEMPTS_PER_DAY=50
KALSHI_RISK_MAX_ATTEMPTS_PER_TICKER_PER_DAY=5
KALSHI_RISK_MAX_NOTIONAL_PER_DAY_DOLLARS=50
KALSHI_RISK_MAX_CONCURRENT_DISPATCHES=2
KALSHI_RISK_MAX_POSITION_CONTRACTS_PER_TICKER=5
# The two below cap exposure across every ticker sharing an AssetConfig.correlation_group (e.g.
# an hourly series and its 15-minute counterpart on the same underlying), a real constraint the
# per-ticker caps above cannot see, since correlated tickers never collide on ticker identity.
KALSHI_RISK_MAX_ATTEMPTS_PER_CORRELATION_GROUP_PER_DAY=10
KALSHI_RISK_MAX_POSITION_CONTRACTS_PER_CORRELATION_GROUP=10
# And these two cap exposure across every strike of one event. They sit between the per-ticker
# and per-group caps and catch what neither can: a ladder-wide sweep of one settlement, which the
# per-ticker cap counts as many small independent positions. Every strike of an event resolves
# off one number, so the position cap here is what actually bounds the loss if that number goes
# the wrong way.
KALSHI_RISK_MAX_ATTEMPTS_PER_EVENT_PER_DAY=6
KALSHI_RISK_MAX_POSITION_CONTRACTS_PER_EVENT=6
KALSHI_RISK_REFIRE_COOLDOWN_SECONDS=60

# Position sizing (execution/position_sizing.py), a real fire's contract count is a fractional-
# Kelly stake off the model's own edge, not the fixed constant above. Values below are
# deliberately conservative starting points; see docs/configuration.md's "Position sizing"
# section for the formula and for why KALSHI_RISK_MAX_POSITION_CONTRACTS_PER_TICKER/
# _PER_CORRELATION_GROUP and KALSHI_RISK_MAX_NOTIONAL_PER_DAY_DOLLARS above need widening
# together with these, a Kelly-sized count at a low price can be large, and the risk gate's
# caps, not this section, are what actually stop it.
KALSHI_KELLY_FRACTION=0.15
KALSHI_MAX_POSITION_PCT_OF_BALANCE=0.02
